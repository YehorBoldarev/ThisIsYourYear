# Copy to .env for local development. The .env file is git-ignored.
# In production these must come from the real environment; .env is ignored there.

# Runtime environment: development | production
APP_ENV=development

# HTTP server
HTTP_PORT=8080
HTTP_READ_TIMEOUT=10s
HTTP_WRITE_TIMEOUT=15s
HTTP_IDLE_TIMEOUT=60s
SHUTDOWN_TIMEOUT=15s

# MongoDB
MONGO_URI=mongodb://localhost:27017
MONGO_DATABASE=thisisyouryear
MONGO_TIMEOUT=10s

# Logging: debug | info | warn | error
LOG_LEVEL=info

# Behind a reverse proxy (e.g. Tailscale Funnel): proxy addresses allowed to state
# the client IP, and the single-IP header they set. Empty = trust no proxy.
# TRUSTED_PROXIES=
# CLIENT_IP_HEADER=X-Forwarded-For

# Invite-only sign-up: at least 8 characters. Empty = open registration.
# REGISTRATION_INVITE_CODE=
