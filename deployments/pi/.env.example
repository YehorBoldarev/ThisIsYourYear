# ThisIsYourYear — Raspberry Pi settings (docs/operations.md, "Install").
#
#   cp .env.example .env && chmod 600 .env     then fill in the values below.
#
# .env holds secrets: it is git-ignored and must never be committed or pasted
# anywhere. Don't use the "$" character in values (Docker Compose treats it
# specially).

# REQUIRED — the secret that signs logins. Generate it once on the Pi with:
#   openssl rand -hex 32
# Changing it later just makes everyone's next page load silently re-authenticate.
JWT_SECRET=

# Invite-only sign-up. People need this code to register; the easiest way is to
# send them the invite link:
#   https://<machine>.<tailnet>.ts.net/register?invite=<this code>
# At least 8 characters. Empty = anyone who finds the site can register.
REGISTRATION_INVITE_CODE=

# Backups (backup.sh, run daily by tiyy-backup.timer). Point BACKUP_DIR at a USB
# drive if you have one — backups on the Pi's own card die with the card.
BACKUP_DIR=/var/backups/thisisyouryear
BACKUP_KEEP=14

# Image versions. The app updates itself nightly from :latest (update.sh). To
# stay on a known-good build, use its tag, e.g. ...thisisyouryear:sha-4271996
# MongoDB is pinned and bumped by hand (monthly checklist).
APP_IMAGE=ghcr.io/yehorboldarev/thisisyouryear:latest
MONGO_IMAGE=mongo:7.0.45

# Optional tuning (defaults shown).
# MONGO_CACHE_GB=1
# LOG_LEVEL=info
# Local port Tailscale Funnel forwards to. Keep 8080 unless something else uses it,
# and then change the `tailscale funnel` command to match.
# PUBLISH_PORT=8080
